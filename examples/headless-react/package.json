{
  "name": "handrail-chat-headless-react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "vite build",
    "check:graph": "node scripts/assert-browser-graph.mjs",
    "test:smoke": "NODE_ENV=test vitest run test/HeadlessChatScreen.test.tsx",
    "check:static": "node scripts/static-check.mjs",
    "check": "npm run typecheck && npm run build && npm run check:graph && npm run test:smoke && npm run check:static"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@handrail/chat": "file:../..",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
