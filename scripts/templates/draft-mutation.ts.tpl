/** Parses an authoritative result and proves coherence with its exact request. */
export function parseSynchronizeDraftResult(
  value: unknown,
  expectedInput: SynchronizeDraftInput,
): SynchronizeDraftResult {
  const request = parseSynchronizeDraftInput(expectedInput);
  const result = requireRecord(value, "result", "malformed_result");
  assertExactKeys(result, RESULT_KEYS, "result", "malformed_result");

  if (result.operation !== "synchronize_draft") {
    throw draftError(
      "malformed_result",
      "result.operation must be synchronize_draft",
    );
  }

  const intent = readIntent(result.intent, "malformed_result");
  const reconciliationStatus = readReconciliationStatus(
    result.reconciliationStatus,
  );
  const conversationId = readIdentifier(
    result.conversationId,
    "result.conversationId",
    "malformed_result",
  ) as ConversationId;
  const baseRevision = readBaseRevision(
    result.baseRevision,
    "result.baseRevision",
    "malformed_result",
  );
  const deviceMutationId = readIdentifier(
    result.deviceMutationId,
    "result.deviceMutationId",
    "malformed_result",
  );
  const idempotencyKey = readBoundedIdempotencyKey(
    result.idempotencyKey,
    "result.idempotencyKey",
    "malformed_result",
  );
  const canonicalRevision = readCanonicalRevision(result.canonicalRevision);
  const canonicalUpdatedAt = readIsoTimestamp(result.canonicalUpdatedAt);
  const draft = parseCanonicalDraftState(result.draft);

  if (
    intent !== request.intent ||
    conversationId !== request.conversationId ||
    baseRevision !== request.baseRevision ||
    deviceMutationId !== request.deviceMutationId ||
    idempotencyKey !== request.idempotencyKey
  ) {
    throw draftError(
      "incoherent_result",
      "result intent and request identity fields must exactly match the request",
    );
  }

  if (reconciliationStatus === "stale_base") {
    if (canonicalRevision <= baseRevision) {
      throw draftError(
        "incoherent_result",
        "a stale-base result must carry a canonical revision newer than baseRevision",
      );
    }
  } else {
    if (canonicalRevision !== baseRevision + 1) {
      throw draftError(
        "incoherent_result",
        "an applied or replayed result must advance baseRevision by one",
      );
    }
    assertRequestedStateMatches(request, draft);
  }

  return {
    operation: "synchronize_draft",
    intent,
    reconciliationStatus,
    conversationId,
    baseRevision,
    deviceMutationId,
    idempotencyKey,
    canonicalRevision,
    canonicalUpdatedAt,
    draft,
  } as SynchronizeDraftResult;
}

