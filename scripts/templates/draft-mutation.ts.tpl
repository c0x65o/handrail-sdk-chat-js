function parseInputBase<Intent extends DraftMutationIntent>(
  input: Record<string, unknown>,
  intent: Intent,
): DraftMutationInputBase<Intent> {
  if (input.intent !== intent) {
    throw draftError("malformed_input", `input.intent must be ${intent}`);
  }
  return {
    operation: "synchronize_draft",
    intent,
    conversationId: readIdentifier(
      input.conversationId,
      "input.conversationId",
      "malformed_input",
    ) as ConversationId,
    baseRevision: readBaseRevision(
      input.baseRevision,
      "input.baseRevision",
      "malformed_input",
    ),
    deviceMutationId: readIdentifier(
      input.deviceMutationId,
      "input.deviceMutationId",
      "malformed_input",
    ),
    idempotencyKey: readBoundedIdempotencyKey(
      input.idempotencyKey,
      "input.idempotencyKey",
