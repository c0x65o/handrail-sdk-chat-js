function parseCanonicalDraftState(value: unknown): CanonicalDraftState {
  const state = requireRecord(
    value,
    "result.draft",
    "malformed_result",
  );
  if (state.kind === "replaced") {
    assertExactKeys(
      state,
      ["kind", "content"],
      "result.draft",
      "malformed_result",
    );
    return {
      kind: "replaced",
      content: parseDraftContent(
        state.content,
        "result.draft.content",
        "malformed_result",
      ),
    };
  }
  if (state.kind === "clear_tombstone") {
    assertExactKeys(
      state,
      ["kind", "content"],
      "result.draft",
      "malformed_result",
    );
    if (state.content !== null) {
      throw draftError(
        "malformed_result",
        "a clear tombstone must carry null content",
      );
    }
    return { kind: "clear_tombstone", content: null };
  }
  throw draftError(
    "malformed_result",
    "result.draft.kind must be replaced or clear_tombstone",
  );
}

function parseDraftContent(
  value: unknown,
  path: string,
  code: "malformed_content" | "malformed_result",
): DraftContent {
  const content = requireRecord(value, path, code);
  assertExactKeys(
    content,
    [
      "format", "text", "attachments",
      ...(Object.hasOwn(content, "mentions") ? ["mentions"] : []),
      ...(Object.hasOwn(content, "replyTo") ? ["replyTo"] : []),
    ],
    path,
    code,
  );
  if (content.format !== "plain" && content.format !== "markdown") {
    throw draftError(code, `${path}.format must be plain or markdown`);
  }
  if (typeof content.text !== "string") {
    throw draftError(code, `${path}.text must be a string`);
  }
  if (containsUnsafeUnicode(content.text)) {
    throw draftError(
      "unsafe_content",
      `${path}.text contains unsafe control characters or malformed Unicode`,
    );
  }
  if (utf8ByteLength(content.text) > MAX_DRAFT_TEXT_UTF8_BYTES) {
    throw draftError(
      code,
      `${path}.text cannot exceed ${MAX_DRAFT_TEXT_UTF8_BYTES} UTF-8 bytes`,
    );
  }
  let mentions: readonly MessageMention[] | undefined;
  if (Object.hasOwn(content, "mentions")) {
    if (!Array.isArray(content.mentions)) {
      throw draftError(code, `${path}.mentions must be an array`);
    }
    if (content.mentions.length > MAX_DRAFT_MENTION_REFERENCES) {
      throw draftError(
        code,
        `${path}.mentions cannot contain more than ${MAX_DRAFT_MENTION_REFERENCES} references`,
      );
    }
    const seenMentionIdentities = new Set<string>();
    mentions = content.mentions.map((value, index) => {
      const mention = parseDraftMention(value, `${path}.mentions[${index}]`, code);
      const identity = mentionIdentity(mention);
      if (seenMentionIdentities.has(identity)) {
        throw draftError(
          "duplicate_mention_reference",
          `${path}.mentions cannot contain duplicate mention references`,
        );
      }
      seenMentionIdentities.add(identity);
      return mention;
    });
  }
  if (!Array.isArray(content.attachments)) {
    throw draftError(code, `${path}.attachments must be an array`);
  }
  if (content.attachments.length > MAX_DRAFT_ATTACHMENT_REFERENCES) {
    throw draftError(
      code,
      `${path}.attachments cannot contain more than ${MAX_DRAFT_ATTACHMENT_REFERENCES} references`,
    );
  }

  const seenAttachmentIds = new Set<string>();
  const attachments = content.attachments.map((value, index) => {
    const referencePath = `${path}.attachments[${index}]`;
    const reference = requireRecord(value, referencePath, code);
    assertExactKeys(reference, ["attachmentId"], referencePath, code);
    const attachmentId = readIdentifier(
      reference.attachmentId,
      `${referencePath}.attachmentId`,
      code,
    ) as AttachmentId;
    if (seenAttachmentIds.has(attachmentId)) {
      throw draftError(
        "duplicate_attachment_reference",
        `${path}.attachments cannot contain duplicate attachmentId values`,
      );
    }
    seenAttachmentIds.add(attachmentId);
    return { attachmentId };
  });

  return {
    format: content.format,
    text: content.text,
    ...(Object.hasOwn(content, "replyTo")
      ? { replyTo: parseDraftReplyReference(content.replyTo, `${path}.replyTo`, code) }
      : {}),
    ...(mentions === undefined ? {} : { mentions }),
    attachments,
  };
}

/** @internal Shared by draft mutation and actor-private snapshot parsers. */
export function parseDraftReplyReference(
  value: unknown,
  path: string,
  code: "malformed_content" | "malformed_result",
): MessageReplyReference {
  const reference = requireRecord(value, path, code);
  assertExactKeys(reference, ["messageId", "notifyAuthor"], path, code);
  const messageId = readIdentifier(reference.messageId, `${path}.messageId`, code);
  if (/[\x00-\x1f\x7f-\x9f\u2028\u2029]/u.test(messageId)) {
    throw draftError(
      "malformed_identifier",
      `${path}.messageId must be a safe identifier`,
    );
  }
  if (typeof reference.notifyAuthor !== "boolean") {
    throw draftError(code, `${path}.notifyAuthor must be a boolean`);
  }
  return {
    messageId: messageId as MessageReplyReference["messageId"],
    notifyAuthor: reference.notifyAuthor,
  };
}

function parseDraftMention(
  value: unknown,
  path: string,
  code: "malformed_content" | "malformed_result",
): MessageMention {
  const mention = requireRecord(value, path, code);
  if (mention.type === "user") {
    assertExactKeys(mention, ["type", "userId"], path, code);
    return {
      type: "user",
      userId: readIdentifier(mention.userId, `${path}.userId`, code) as UserId,
    };
  }
  if (mention.type === "conversation") {
    assertExactKeys(mention, ["type", "conversationId"], path, code);
    return {
      type: "conversation",
      conversationId: readIdentifier(
        mention.conversationId,
        `${path}.conversationId`,
        code,
      ) as ConversationId,
    };
  }
  if (mention.type === "entity") {
    assertExactKeys(mention, ["type", "entity"], path, code);
    const entity = requireRecord(mention.entity, `${path}.entity`, code);
    assertExactKeys(entity, ["type", "id"], `${path}.entity`, code);
    return {
      type: "entity",
      entity: {
        type: readIdentifier(entity.type, `${path}.entity.type`, code),
        id: readIdentifier(entity.id, `${path}.entity.id`, code),
      },
    };
  }
  throw draftError(code, `${path}.type must be user, conversation, or entity`);
}

function mentionIdentity(mention: MessageMention): string {
  switch (mention.type) {
    case "user":
      return `user:${mention.userId}`;
    case "conversation":
      return `conversation:${mention.conversationId}`;
    case "entity":
      return `entity:${mention.entity.type}\u0000${mention.entity.id}`;
  }
}

function assertRequestedStateMatches(
  request: SynchronizeDraftInput,
  draft: CanonicalDraftState,
): void {
  if (request.intent === "clear") {
    if (draft.kind !== "clear_tombstone") {
      throw draftError(
        "incoherent_result",
        "a settled clear result must carry a clear tombstone",
      );
    }
    return;
  }
  if (
    draft.kind !== "replaced" ||
    !draftContentEquals(draft.content, request.content)
  ) {
    throw draftError(
      "incoherent_result",
      "a settled replace result must carry the exact requested canonical content",
    );
  }
}

function draftContentEquals(left: DraftContent, right: DraftContent): boolean {
  return (
    left.format === right.format &&
    left.text === right.text &&
    left.replyTo?.messageId === right.replyTo?.messageId &&
    left.replyTo?.notifyAuthor === right.replyTo?.notifyAuthor &&
    (left.mentions === undefined
      ? right.mentions === undefined
      : right.mentions !== undefined &&
        left.mentions.length === right.mentions.length &&
        left.mentions.every(
          (mention, index) =>
            mentionIdentity(mention) === mentionIdentity(right.mentions![index]!),
        )) &&
    left.attachments.length === right.attachments.length &&
    left.attachments.every(
      (reference, index) =>
        reference.attachmentId === right.attachments[index]?.attachmentId,
    )
  );
}

function readIntent(
  value: unknown,
  code: "malformed_input" | "malformed_result",
): DraftMutationIntent {
  if (value !== "replace" && value !== "clear") {
    throw draftError(code, "intent must be replace or clear");
  }
  return value;
}

function readReconciliationStatus(
  value: unknown,
): DraftMutationReconciliationStatus {
  if (value !== "applied" && value !== "replayed" && value !== "stale_base") {
    throw draftError(
      "malformed_result",
      "result.reconciliationStatus must be applied, replayed, or stale_base",
    );
  }
  return value;
}

function readBaseRevision(
  value: unknown,
  path: string,
  code: "malformed_input" | "malformed_result",
): number {
  if (
    !Number.isSafeInteger(value) ||
    (value as number) < 0 ||
    (value as number) >= Number.MAX_SAFE_INTEGER
  ) {
    throw draftError(
      "malformed_revision",
      `${path} must be a nonnegative safe integer that can advance by one`,
    );
  }
  return value as number;
}

function readCanonicalRevision(value: unknown): number {
  if (!Number.isSafeInteger(value) || (value as number) < 1) {
    throw draftError(
      "malformed_revision",
      "result.canonicalRevision must be a positive safe integer",
    );
  }
  return value as number;
}

function readIdentifier(
  value: unknown,
  path: string,
  code:
    | "malformed_input"
    | "malformed_result"
    | "malformed_content"
    | "malformed_event",
): string {
  if (
    typeof value !== "string" ||
    value.length === 0 ||
    value.trim() !== value ||
    value !== value.normalize("NFC") ||
    containsUnsafeUnicode(value) ||
    utf8ByteLength(value) > MAX_DRAFT_IDENTIFIER_UTF8_BYTES
  ) {
    throw draftError(
      "malformed_identifier",
      `${path} must be a safe, NFC-normalized identifier of at most ${MAX_DRAFT_IDENTIFIER_UTF8_BYTES} UTF-8 bytes`,
    );
  }
  return value;
}

function readBoundedIdempotencyKey(
  value: unknown,
  path: string,
  code: "malformed_input" | "malformed_result",
): string {
  if (
    typeof value !== "string" ||
    value.trim().length === 0 ||
    value.trim() !== value ||
    containsUnsafeUnicode(value) ||
    utf8ByteLength(value) > MAX_DRAFT_IDEMPOTENCY_KEY_UTF8_BYTES
  ) {
    throw draftError(
      code,
      `${path} must be a safe nonblank string of at most ${MAX_DRAFT_IDEMPOTENCY_KEY_UTF8_BYTES} UTF-8 bytes`,
    );
  }
  return value;
}

function readIsoTimestamp(value: unknown): IsoTimestamp {
  if (
    typeof value !== "string" ||
    !ISO_TIMESTAMP_PATTERN.test(value) ||
    !Number.isFinite(Date.parse(value))
  ) {
    throw draftError(
      "malformed_result",
      "result.canonicalUpdatedAt must be an ISO-8601 timestamp",
    );
  }
  return value;
}

function rejectServerDerivedFields(value: unknown, path = "input"): void {
  if (Array.isArray(value)) {
    value.forEach((entry, index) =>
      rejectServerDerivedFields(entry, `${path}[${index}]`),
    );
    return;
  }
  if (!isRecord(value)) return;

  for (const [key, nested] of Object.entries(value)) {
    const normalizedKey = key.replaceAll(/[^a-zA-Z0-9]/g, "").toLowerCase();
    const isDraftUserMentionId =
      key === "userId" &&
      value.type === "user" &&
      /^input\.content\.mentions\[\d+\]$/.test(path);
    if (SERVER_DERIVED_FIELDS.has(normalizedKey) && !isDraftUserMentionId) {
      throw draftError(
        "trusted_identity_field",
        `${path}.${key} is server-derived and cannot be supplied by a client`,
      );
    }
    rejectServerDerivedFields(nested, `${path}.${key}`);
  }
}

function assertExactKeys(
  value: Record<string, unknown>,
  expected: readonly string[],
  path: string,
  code:
    | "malformed_input"
    | "malformed_result"
    | "malformed_content"
    | "malformed_event",
): void {
  const expectedSet = new Set(expected);
  for (const key of Object.keys(value)) {
    if (!expectedSet.has(key)) {
      throw draftError(code, `${path}.${key} is not supported`);
    }
  }
  for (const key of expected) {
    if (!Object.hasOwn(value, key)) {
      throw draftError(code, `${path}.${key} is required`);
    }
  }
}

function requireRecord(
  value: unknown,
  path: string,
  code:
    | "malformed_input"
    | "malformed_result"
    | "malformed_content"
    | "malformed_event",
): Record<string, unknown> {
  if (!isRecord(value)) {
    throw draftError(code, `${path} must be an object`);
  }
  return value;
}

function containsUnsafeUnicode(value: string): boolean {
  for (let index = 0; index < value.length; index += 1) {
    const codeUnit = value.charCodeAt(index);
    if (
      (codeUnit <= 0x1f &&
        codeUnit !== 0x09 &&
        codeUnit !== 0x0a &&
        codeUnit !== 0x0d) ||
      (codeUnit >= 0x7f && codeUnit <= 0x9f)
    ) {
      return true;
    }
    if (codeUnit >= 0xd800 && codeUnit <= 0xdbff) {
      const next = value.charCodeAt(index + 1);
      if (index + 1 >= value.length || next < 0xdc00 || next > 0xdfff) return true;
      index += 1;
    } else if (codeUnit >= 0xdc00 && codeUnit <= 0xdfff) {
      return true;
    }
  }
  return false;
}

function utf8ByteLength(value: string): number {
  return new TextEncoder().encode(value).byteLength;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function draftError(
  code: DraftMutationParseErrorCode,
  message: string,
): DraftMutationParseError {
  return new DraftMutationParseError(code, message);
}
