    "check:attachments": "node scripts/generate-attachments.mjs --check",
    "check:conversation-archive": "node scripts/generate-conversation-archive.mjs --check",
    "check:conversation-creation": "node scripts/generate-conversation-creation.mjs --check",
    "check:conversation-membership": "node scripts/generate-conversation-membership.mjs --check",
